{
  "name": "jord-jd/laravel-extendable-basket",
  "description": "🛒 Laravel Extendable Basket provides several abstract classes that implement basic ecommerce basket functionality",
  "type": "library",
  "require": {
    "php": ">=7.1",
    "laravel/framework": "^5.5||^6.0||^7.0||^8.0||^9.0||^10.0||^11.0||^12.0||^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^3.5||^4.0||^5.0||^6.0||^7.0||^8.0||^9.0||^10.0||^11.0",
    "phpunit/phpunit": "^7.5||^8.5||^9.6||^10.5||^11.5||^12.5",
    "doctrine/dbal": "^2.13||^3.0||^4.0"
  },
  "license": "LGPL-3.0-only",
  "authors": [
    {
      "name": "Jordan Hall",
      "email": "jordan@hall05.co.uk"
    }
  ],
  "autoload": {
    "psr-4": {
      "JordJD\\LaravelExtendableBasket\\": "./src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "JordJD\\LaravelExtendableBasket\\Tests\\": "./tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "JordJD\\LaravelExtendableBasket\\Providers\\LaravelExtendableBasketServiceProvider"
      ]
      },
      "branch-alias": {
        "dev-master": "6.1-dev"
      }
  },
  "replace": {
    "divineomega/laravel-extendable-basket": "self.version"
  },
  "config": {
    "allow-plugins": {
      "kylekatarnls/update-helper": false
    }
  }
}
